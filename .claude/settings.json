{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python -c \"import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'.claude','hooks','aiworkhub_tool_guard.py');os.path.isfile(p) and runpy.run_path(p,run_name='__main__')\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|Read|Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python -c \"import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd(),'.claude','hooks','aiworkhub_tool_guard.py');sys.argv=[p,'--reminder'];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git -C D:/Dev/AIWorkHub/.claude/worktrees/agent-a967c15de704afe82 status --short --branch)",
      "Bash(git -C D:/Dev/AIWorkHub/.claude/worktrees/agent-a967c15de704afe82 switch -c nf-2026-00027-prewarm-bound adae201)",
      "mcp__AIWorkHub__aiworkhub_manager_semantic_edit_prepare"
    ],
    "deny": [
      "Grep",
      "Glob",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tree *)"
    ]
  }
}
