{
  "mcpServers": {
    "aiworkhub": {
      "command": "python3",
      "args": [
        "-m",
        "aiworkhub.server"
      ],
      "env": {
        "PYTHONPATH": "/path/to/AIWorkHub/tools/aiworkhub/src",
        "AIWORKHUB_REPO": "/path/to/AIWorkHub",
        "AIWORKHUB_ALLOW_WRITES": "0"
      }
    }
  }
}

