{
  "checks": [
    {
      "id": "quality-gate-regression",
      "kind": "test",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_completion_quality_gate.py",
        "tests/test_quality_verdict_v2.py",
        "tests/test_combined_tree_workspace.py"
      ]
    },
    {
      "id": "python-critical-lint",
      "kind": "lint",
      "command": [
        "ruff",
        "check",
        "src/aiworkhub",
        "scripts",
        "tests"
      ]
    },
    {
      "id": "typed-kernel",
      "kind": "typecheck",
      "command": [
        "mypy"
      ]
    },
    {
      "id": "extension-regression",
      "kind": "test",
      "command": [
        "npm",
        "--prefix",
        "vscode-extension",
        "test"
      ]
    },
    {
      "id": "release-metadata",
      "kind": "build",
      "command": [
        "{python}",
        "scripts/release_metadata.py",
        "check"
      ]
    }
  ]
}
