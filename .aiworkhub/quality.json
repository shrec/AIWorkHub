{
  "checks": [
    {
      "id": "quality-gate-regression",
      "kind": "test",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_completion_quality_gate.py",
        "tests/test_quality_verdict_v2.py",
        "tests/test_combined_tree_workspace.py"
      ],
      "paths": [
        ".aiworkhub/quality.json",
        "src/aiworkhub/quality*.py",
        "src/aiworkhub/known_bug_scanner.py",
        "src/aiworkhub/worker_workspace.py",
        "tests/test_*quality*.py",
        "tests/test_combined_tree_workspace.py"
      ]
    },
    {
      "id": "python-critical-lint",
      "kind": "lint",
      "command": [
        "ruff",
        "check",
        "src/aiworkhub",
        "scripts",
        "tests"
      ],
      "paths": [
        "*.py",
        "src/**/*.py",
        "scripts/*.py",
        "scripts/**/*.py",
        "tests/*.py",
        "tests/**/*.py"
      ]
    },
    {
      "id": "typed-kernel",
      "kind": "typecheck",
      "command": [
        "mypy"
      ],
      "paths": ["src/aiworkhub/*.py", "src/aiworkhub/**/*.py"]
    },
    {
      "id": "extension-regression",
      "kind": "test",
      "command": [
        "npm",
        "--prefix",
        "vscode-extension",
        "test"
      ],
      "paths": ["vscode-extension/**"]
    },
    {
      "id": "release-metadata",
      "kind": "build",
      "command": [
        "{python}",
        "scripts/release_metadata.py",
        "check"
      ],
      "paths": [
        "pyproject.toml",
        "src/aiworkhub/__init__.py",
        "vscode-extension/package.json",
        "scripts/release_metadata.py",
        ".github/workflows/release.yml"
      ]
    }
  ]
}
