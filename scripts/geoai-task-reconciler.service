# Repo-local systemd --user unit template for the B412 durable task
# reconciler (tools/geoai-task-mcp/src/geoai_task_mcp/task_reconciler.py).
#
# NOT installed, started, or enabled by the worker that authored this file --
# per the B412 task contract this template is a candidate only. Codex (the
# coordinator) reviews it, then applies it manually, e.g.:
#
#   mkdir -p ~/.config/systemd/user
#   cp tools/geoai-task-mcp/scripts/geoai-task-reconciler.service \
#      ~/.config/systemd/user/geoai-task-reconciler.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now geoai-task-reconciler.service
#
# The reconciler is deliberately token-free: it performs only bounded
# filesystem/process/SQLite lifecycle checks (via the existing
# ProcessManager finalize path) and never calls Claude, Codex, DeepSeek, or
# any chat endpoint, so it is safe to run continuously and unattended.

[Unit]
Description=GeoAI Task MCP durable worker reconciler (B412, token-free)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/GeoAI
Environment=GEOAI_REPO=%h/GeoAI
Environment=GEOAI_TASK_MCP_RECONCILER_SCAN_INTERVAL_SECONDS=30
Environment=GEOAI_TASK_MCP_ALLOW_WRITES=1
ExecStart=%h/GeoAI/.venv/bin/geoai-task-reconciler daemon --repo %h/GeoAI
Restart=on-failure
RestartSec=10
# Isolated worker worktrees currently live under the host /tmp tree, so the
# reconciler must share that namespace in order to validate and promote them.
PrivateTmp=false
NoNewPrivileges=true

[Install]
WantedBy=default.target
