{
  "name": "aiworkhub",
  "displayName": "AIWorkHub",
  "description": "Repository-native AI orchestration for VS Code: plan work, coordinate models, query source intelligence, preserve context and verify results.",
  "version": "0.8.3",
  "publisher": "shrec",
  "license": "MIT",
  "icon": "media/aiworkhub-icon.png",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "aiworkhub",
    "ai agents",
    "agent orchestration",
    "developer tools",
    "mcp",
    "multi agent",
    "source graph",
    "task planning",
    "remote-ssh"
  ],
  "galleryBanner": {
    "color": "#07111f",
    "theme": "dark"
  },
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onCommand:aiworkhub.openDashboard",
    "onCommand:aiworkhub.refreshDashboard",
    "onCommand:aiworkhub.restartDashboard",
    "onCommand:aiworkhub.selectRepository",
    "onView:aiworkhub.view",
    "onWebviewPanel:aiworkhub.dashboard"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node test/run-all.js",
    "test:multirepo-connecting": "node test/multirepo-connecting.test.js",
    "test:reloadless-runtime-repair": "node test/reloadless-runtime-repair.test.js",
    "package": "node test/package-vsix.js"
  },
  "contributes": {
    "configurationDefaults": {
      "chatgpt.cliExecutable": "aiworkhub-app-server-mux"
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiworkhub",
          "title": "AIWorkHub",
          "icon": "media/aiworkhub-activity.svg"
        }
      ]
    },
    "views": {
      "aiworkhub": [
        {
          "type": "webview",
          "id": "aiworkhub.view",
          "name": "AIWorkHub"
        }
      ]
    },
    "commands": [
      {
        "command": "aiworkhub.openDashboard",
        "title": "AIWorkHub: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "aiworkhub.refreshDashboard",
        "title": "AIWorkHub: Refresh Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "aiworkhub.restartDashboard",
        "title": "AIWorkHub: Restart MCP Connection",
        "icon": "$(debug-restart)"
      },
      {
        "command": "aiworkhub.selectRepository",
        "title": "AIWorkHub: Select Repository",
        "icon": "$(repo)"
      }
    ],
    "configuration": {
      "title": "AIWorkHub",
      "properties": {
        "aiworkhub.refreshIntervalMs": {
          "type": "number",
          "default": 30000,
          "enum": [
            10000,
            30000,
            60000
          ],
          "description": "Default auto-refresh interval in milliseconds for a newly opened AIWorkHub dashboard editor tab."
        },
        "aiworkhub.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Python executable. Empty uses the selected repository virtual environment when present, otherwise Python from the system PATH."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shrec/AIWorkHub.git"
  },
  "bugs": {
    "url": "https://github.com/shrec/AIWorkHub/issues"
  },
  "homepage": "https://github.com/shrec/AIWorkHub"
}
